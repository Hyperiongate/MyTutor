# =============================================================================
# screenwatch.yml  --  THE GOVERNOR'S EYES ON PRODUCTION  --  Hyperion Shift LLC
# -----------------------------------------------------------------------------
# CHANGE NOTES (keep newest at top):
#   2026-09-25  BUILD ye -- THE SCRIPTED LANE GOES NIGHTLY. A second job, `scripted`,
#               beside the live one: it drives the night's rotating slice of the
#               AUTHORED catalogue (screencheck.py --script rota, build xy's lane: the
#               engine walks the lesson, the real page plays every beat, no site, no
#               secret, no model call, no cost) and judges every turn with the same
#               checks -- S8 the last line on the screen, S9 figure widths agree, S10
#               the figure's words readable, and the rest. Eight lessons a night in
#               catalogue order, so every lesson of the 360 is watched once every ~45
#               nights; --rota-day N re-runs any night by hand. It fails on MEDIUM and
#               above: the over-tall beat's S9 LOW is the pu rule working (by design)
#               and would fail every night otherwise -- the report still lists it.
#               The two jobs are independent: the scripted lane runs whether or not
#               SCREENWATCH_CODE is set, and the live lane is exactly what it was.
#   2026-08-18  NEW FILE (build hw, Phase 5's last queued eye). The screen auditor
#               (screencheck.py, build gn) has judged rendered screens in every
#               battery run since it was written -- against FIXTURES. The one thing
#               still missing from "somebody should be checking this" was a nightly
#               look at the REAL site: Render has no browser, so the capture could
#               never live on the heartbeat. GitHub's runners DO have one. This
#               workflow drives a real three-turn lesson on mrcadabra.com every
#               night with a dedicated audit student, judges the rendered screens
#               with the same six checks the battery runs, uploads the report and
#               the screenshots as artifacts, and FAILS the run when there are
#               findings -- which lands in Jim's inbox via GitHub's own
#               notification, no new service and no new key beyond one repo secret.
#
#               ⚠️ JIM'S ONE-TIME SETUP: create a dedicated audit student (e.g. a
#               child named "Screen Watch" on /family -- it writes real turns and
#               spends a few model calls per night, so never use a real student's
#               code), then add its login code as the repo secret SCREENWATCH_CODE
#               (GitHub -> Settings -> Secrets and variables -> Actions).
#
#               Cost per night: one three-turn lesson (~3 model calls + a little
#               TTS). The run refuses loudly if the secret is missing.
# =============================================================================
name: screenwatch

on:
  schedule:
    - cron: "30 9 * * *"        # nightly 09:30 UTC (~1:30am Pacific), after the night watch
  workflow_dispatch: {}          # and on demand, from the Actions tab

jobs:
  screenwatch:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install the one thing the judge itself never needs
        run: |
          pip install playwright
          playwright install --with-deps chromium

      - name: Drive a real lesson and judge the screen
        env:
          SCREENWATCH_CODE: ${{ secrets.SCREENWATCH_CODE }}
        run: |
          if [ -z "$SCREENWATCH_CODE" ]; then
            echo "::error::Set the SCREENWATCH_CODE repo secret — a DEDICATED audit student's login code (it writes real turns; never a real student)."
            exit 2
          fi
          python screencheck.py --live https://mrcadabra.com \
            --code "$SCREENWATCH_CODE" --course geometry \
            --shots screenwatch-shots --out screenwatch-report.md

      - name: Keep the evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: screenwatch-${{ github.run_id }}
          path: |
            screenwatch-report.md
            screenwatch-shots/
          retention-days: 30
          if-no-files-found: ignore

  scripted:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install the one thing the judge itself never needs
        run: |
          pip install playwright
          playwright install --with-deps chromium

      - name: Drive tonight's slice of the authored catalogue and judge every turn
        run: |
          python screencheck.py --script rota --rota-size 8 --fail-on MEDIUM \
            --shots screenwatch-script-shots --out screenwatch-script-report.md

      - name: Keep the evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: screenwatch-script-${{ github.run_id }}
          path: |
            screenwatch-script-report.md
            screenwatch-script-shots/
          retention-days: 30
          if-no-files-found: ignore

# A failing `screenwatch` job = the screen auditor found something on the LIVE site (or
# the site was unreachable). A failing `scripted` job = a MEDIUM or HIGH finding on one of
# tonight's eight authored lessons (the run's log names them; re-run that night by hand
# with --rota-day). Open the run's artifact for the report and the screenshots.
# I did no harm and this file is not truncated.
